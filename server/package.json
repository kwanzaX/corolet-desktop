{
  "name": "@corolet-desktop/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Corolet Desktop server: NestJS + Socket.IO streaming, LangChain.js RAG on ChromaDB, and an MCP server over the same memory.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:bun": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "mcp": "node dist/mcp.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "e2e:server": "bun test/support/e2e-server.ts",
    "eval": "node --env-file=.env --import tsx eval/rag.eval.ts",
    "smoke": "node --env-file=.env --import tsx scripts/smoke.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.17",
    "@langchain/textsplitters": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/websockets": "^12.1.3",
    "chromadb": "^3.5.0",
    "llm-harness-kit": "^0.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@swc/core": "^1.16.18",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.7",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
